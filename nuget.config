<?xml version="1.0" encoding="utf-8"?>
<!-- Restore from nuget.org only. Without this the restore inherits whatever private feeds
     the machine has configured globally, which fails for anyone cloning this repo. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
